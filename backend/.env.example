# Copy to backend/.env (ignored). Never put real values in git or chat.
# Public collection stays off until SMTP, DNS and privacy are approved.
SUBMISSIONS_ENABLED=false
HOST=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=info@lareirasoftware.com
ALLOWED_ORIGINS=https://lareirasoftware.com,https://www.lareirasoftware.com
PORT=4180

# Containers use mounted Swarm secrets instead of SMTP_USER/SMTP_PASS.
# SMTP_USER_FILE=/run/secrets/lareira_smtp_user
# SMTP_PASS_FILE=/run/secrets/lareira_smtp_password
