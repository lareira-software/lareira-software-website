{
  "name": "lareira-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "textos": "node --experimental-strip-types --no-warnings scripts/generar-textos.ts",
    "foto": "remotion still src/index.ts Reel01FotoForno assets/o-forno.jpg --image-format=jpeg --jpeg-quality=90",
    "render": "npm run textos && npm run foto && remotion render src/index.ts Reel01Iceberg out/reel-01-iceberg.mp4 --codec=h264 && remotion still src/index.ts Reel01Portada out/reel-01-cover.png",
    "capturas": "node scripts/capturas.mjs out/reel-01-iceberg.mp4 1 5 12 20 25"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "@remotion/noise": "4.0.544",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
